import numpy as np
import rclpy
from rclpy.node import Node
from rclpy.qos import QoSProfile, ReliabilityPolicy, HistoryPolicy

from geometry_msgs.msg import Twist
from sensor_msgs.msg import Image
from cv_bridge import CvBridge
import cv2

# ─────────────────────────────────────────
#  4本スキャンライン制御パラメータ (Pure Pursuit 先読み)
# ─────────────────────────────────────────
SCAN_Y_CURVE_RATIO      = 0.50     # 最上段: カーブ検知・速度制御専用 (0.50)
SCAN_Y_FAR_STEER_RATIO  = 0.55     # 上段: 先読みライン (0.55)
SCAN_Y_MID_STEER_RATIO  = 0.65     # 中段: 中間補間ライン (0.65)
SCAN_Y_NEAR_STEER_RATIO = 0.75     # 下段: 近景基準ライン (0.75)

# 3点加重平均ウェイト
WEIGHT_NEAR             = 0.5      # 近景重み
WEIGHT_MID              = 0.3      # 中間重み
WEIGHT_FAR              = 0.2      # 先読み重み

# ─────────────────────────────────────────
#  レーシング制御パラメータ
# ─────────────────────────────────────────
SPEED_FAST          = 0.6      # 直線走行速度（ファストアウト） [m/s]
