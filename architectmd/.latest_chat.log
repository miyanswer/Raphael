import pytest
import numpy as np
from simulation.course import CourseGenerator
from simulation import config

def test_course_is_closed():
    cg = CourseGenerator(config.SEGMENTS)
    points = cg.generate_course_points()
    assert len(points) > 0
    assert points.shape[1] == 2

    start = points[0]
    end = points[-1]
    distance = np.linalg.norm(end - start)

    assert distance < config.COURSE_CLOSE_TOLERANCE, (
        f"コースが閉じていません: 始点-終点間距離 = {distance:.4f}m "
        f"(許容値: {config.COURSE_CLOSE_TOLERANCE}m)\n"
        f"始点: {start}, 終点: {end}"
    )

def test_node_count():
    cg = CourseGenerator(config.SEGMENTS)
    node_positions = cg.generate_node_positions()
    assert len(node_positions) == 16
    for i in range(1, 17):
        node_id = f"N{i:02d}"
        assert node_id in node_positions


【社長からの修正・改善要望】:
カーブをスキャンラインじゃなくて黒路面の形状から判断するのはどう？
assistant: 社長、素晴らしい着眼点です。
単一のスキャンライン（Y=0.55）の重心だけで判断するよりも、抽出した「路面全体の形状」からカーブを予測する方が、ノイズに強くより人間の感覚に近い先読みが可能になります。

現在の設計では、すでに「足元から遠方にかけての4点（0.90, 0.80, 0.70, 0.60）」を抽出し、**2次関数（Polyfit）で路面の曲線を近似**しています。この既存の処理を活かして形状を判断する、以下の3つの修正アプローチを提案します。

### 【修正方針の選択肢】

*   **案A：Polyfitの「曲がり具合（2次係数）」を利用する（推奨）**
    すでに計算している2次近似曲線（$X = aY^2 + bY + c$）の **係数 `a`（曲率）** や **係数 `b`（傾き）** の絶対値の大きさを評価します。曲線が一定以上曲がっていれば「カーブ」と判定します。
    *   **メリット:** 追加の画像処理コストがゼロで、既存のノイズ除去（連続トラッキング）の恩恵をそのまま受けられます。
*   **案B：トラッキングした4点の「横ズレ幅」を利用する**
    足元から遠方にかけて抽出した4つの中心座標（X座標）のうち、「最大値と最小値の差分（横幅のズレ）」を計算します。ズレが画面幅の一定割合（例：15%）を超えたらカーブと判定します。
    *   **メリット:** 計算が非常にシンプルで直感的です。
*   **案C：黒色領域全体の「輪郭（Contour）」を解析する**
    OpenCVの機能（`findContours`等）を使い、画面内の黒色（路面）ブロック全体の輪郭形状や傾きを直接解析してカーブを判定します。
    *   **懸念点:** 画面奥の影やノイズを拾ってしまうリスクが復活するため、精度を保つためのフィルタリング処理が追加で必要になります。

---
私としては、既存の堅牢なトラッキング結果をそのまま活用できる **案A** または **案B** が最もスマートで確実だと考えますが、社長はどのアプローチがイメージに近いでしょうか？