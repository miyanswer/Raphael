        cm.setFrame(-500, 500, -500, 500)
        ground = self.render.attachNewNode(cm.generate())
        ground.setHpr(0, -90, 0)
        ground.setPos(0, 0, -0.02)
        ground.setColor(0.55, 0.27, 0.07, 1.0)  # 大地色（サドルブラウン）

       

